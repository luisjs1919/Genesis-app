{
  "name": "genesis-caja-launcher",
  "version": "1.1.0",
  "description": "Launcher ligero de terminal de ventas en red local para Génesis POS",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win portable"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.genesis.pos.caja.launcher",
    "productName": "GenesisCaja",
    "win": {
      "target": "portable"
    }
  }
}